<% lines = @event.completed_lines; can_act = local_assigns.fetch(:interactive, true) && current_participant && @event.state == 'live' %>
<div class="bingo-grid" aria-label="Plansza bingo 5 na 5" data-controller="fit-text">
  <% @event.cells.includes(:proposals).each do |cell| %>
    <% proposals = cell.current_proposals; mine = proposals.find { |p| p.participant_id == current_participant&.id } %>
    <article class="bingo-cell mark-<%= cell.mark %> <%= 'center-cell' if cell.position == 12 %> <%= 'winning-cell' if lines.flatten.include?(cell.position) %>" data-position="<%= cell.position %>" aria-label="Pole <%= cell.position + 1 %>: <%= cell.text %>, <%= mark_label(cell.mark) %>">
      <div class="cell-top"><span><%= format('%02d', cell.position + 1) %></span><% if cell.position == 12 %><span class="center-label">TYP SPOŁECZNOŚCI ✦</span><% end %></div>
      <div class="cell-text"><span data-fit-text-target="text"><%= cell.text %></span></div>
      <span class="official-mark" aria-hidden="true"><%= mark_symbol(cell.mark) %></span>
      <div class="cell-bottom">
        <div class="proposal-counts" role="group" aria-label="Propozycje społeczności">
          <% %w[question cross].each do |mark| %>
            <% count = proposals.count { |proposal| proposal.mark == mark }; selected = mine&.mark == mark %>
            <% if can_act %>
              <%= button_to event_proposals_path(@event), params: { cell_id: cell.id, mark: selected ? 'blank' : mark, revision: cell.revision, presentation: @presentation ? '1' : '0' }, class: "proposal-button #{mark}-count", data: { board_control: "proposal-#{cell.position}-#{mark}" }, aria: { label: "#{selected ? 'Cofnij propozycję' : 'Zaproponuj'} #{mark_symbol(mark)} w polu #{cell.position + 1} (#{count})", pressed: selected }, title: "#{selected ? 'Cofnij propozycję' : 'Zaproponuj'}: #{mark_label(mark)}", form: { data: { action: "submit->board#submit" } } do %>
                <span><%= mark_symbol(mark) %></span><span class="proposal-total"><%= count %></span>
              <% end %>
            <% else %>
              <span class="proposal-counter <%= mark %>-count"><span><%= mark_symbol(mark) %></span><span class="proposal-total"><%= count %></span></span>
            <% end %>
          <% end %>
        </div>
        <% if can_act && current_participant.admin? %>
          <div class="admin-decisions" role="group" aria-label="Decyzja administracji">
            <% %w[question cross].each do |mark| %>
              <% selected = cell.mark == mark %>
              <%= button_to mark_symbol(mark), mark_admin_event_path(@event), params: { cell_id: cell.id, mark: selected ? 'blank' : mark, revision: cell.revision, presentation: @presentation ? '1' : '0' }, class: "decision-button decision-#{mark}", data: { board_control: "decision-#{cell.position}-#{mark}" }, aria: { label: "#{selected ? 'Wyczyść' : 'Ustaw'} oficjalne #{mark_symbol(mark)} w polu #{cell.position + 1}", pressed: selected }, title: "#{selected ? 'Wyczyść oznaczenie' : "Decyzja administracji: #{mark_label(mark)}"}", form: { data: { action: "submit->board#submit" } } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
<% if lines.any? %><div class="bingo-celebration" role="status">✦ BINGO! <span>Ukończone linie: <%= lines.length %></span></div><% end %>
