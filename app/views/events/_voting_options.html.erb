<div class="options-list" role="list">
  <% @options.each do |option| %>
    <% vote = @votes_by_option[option.id]; voted = vote.present? %>
    <article class="option-card <%= 'selected' if voted %>" id="option-<%= option.id %>" role="listitem">
      <% count = @counts.fetch(option.id, 0); voters = @voters_by_option[option.id] %>
      <% if voters.present? %>
        <button type="button" class="option-count" id="option-<%= option.id %>-count" data-option-id="<%= option.id %>" data-action="event-status#openVoters" aria-haspopup="dialog" aria-label="Liczba głosów: <%= count %>. Pokaż, kto głosował" title="Kto głosował"><%= count %></button>
        <template id="option-<%= option.id %>-voters" data-title="<%= option.text %>"><% voters.each do |name| %><li><%= name %></li><% end %></template>
      <% else %>
        <span class="option-count" aria-label="Liczba głosów: <%= count %>" title="Liczba głosów"><%= count %></span>
      <% end %>
      <h2><%= option.text %><% if voted %><span class="sr-only"> (Twój głos)</span><% end %></h2>
      <div class="option-bottom">
        <% if voted && @event.voting_open? %><%= button_to "Cofnij głos", event_vote_path(@event, vote), method: :delete, params: { q: @query.presence }, class: "button vote-button withdraw-button", id: "option-#{option.id}-vote", form: { data: { action: "submit->event-status#submit", option_id: option.id } } %>
        <% elsif voted %><span class="voted-label">Twój głos ✓</span>
        <% elsif @event.voting_open? && current_participant && @remaining.positive? %>
          <%= button_to "Głosuję +1", event_votes_path(@event), params: { option_id: option.id, q: @query.presence }, class: "button vote-button", id: "option-#{option.id}-vote", form: { data: { action: "submit->event-status#submit", option_id: option.id } } %>
        <% elsif @event.voting_open? && !current_participant %><%= link_to "Głosuję +1", sign_in_path, class: "button vote-button" %>
        <% else %><span class="muted"><%= @remaining == 0 ? 'Limit wykorzystany' : 'Głosowanie nieaktywne' %></span><% end %>
      </div>
    </article>
  <% end %>
</div>
<% if @options.empty? %>
  <div class="empty-card">
    <span class="empty-symbol">✦</span>
    <% if @query.present? %>
      <h2>Brak wyników.</h2>
      <% if @can_add_option %>
        <p>Nikt jeszcze tego nie zaproponował.</p>
        <%= form_with url: event_options_path(@event), class: "empty-add-form", data: { action: "submit->event-status#submit", voting_kind: "search" } do |form| %>
          <%= form.hidden_field :text, value: @search_text %>
          <%= form.hidden_field :q, value: @query %>
          <%= form.button type: "submit", class: "button primary empty-add-button", id: "search-option-submit" do %>Dodaj „<%= @search_text %>” <span class="button-suffix" aria-hidden="true">+1</span><% end %>
        <% end %>
      <% elsif @event.voting_open? && !current_participant %>
        <p>Zaloguj się, aby dodać tę propozycję.</p>
        <%= link_to "Zaloguj się", sign_in_path, class: "button secondary empty-add-button" %>
      <% else %>
        <p><%= add_option_unavailable_message %></p>
      <% end %>
    <% else %>
      <h2>Brak propozycji.</h2><p>Propozycje można dodawać w czasie głosowania.</p>
    <% end %>
  </div>
<% end %>
