<div class="board-page-heading"><div><h1><%= @event.title %></h1><p><%= phase_label(@event.phase) %> · <span class="legend-question">? do dyskusji</span> · <span class="legend-cross">X potwierdzone</span></p></div><div class="heading-actions"><%= link_to "Tryb prezentacji ↗", presentation_event_path(@event), class: "button secondary", target: "_blank", rel: "noopener" %><%= link_to "Zapis losowania ↓", draw_record_event_path(@event), class: "text-link" %></div></div>
<%= render "events/board_shell" %>
<% unless current_participant %><p class="board-help"><%= link_to "Zaloguj się, aby proponować oznaczenia.", sign_in_path %></p><% end %>
