<% content_for :title, "#{@event.title} · TGA Bingo" %>
<%= render "events/navigation" %>
<% if @event.draw %>
  <%= render "events/live" %>
<% else %>
  <section class="hero">
    <div class="hero-art"><%= image_tag "uv-space.png", alt: "UV, Xenor i Foxtrot w kosmicznej oprawie UV o grach", fetchpriority: "high" %></div>
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-star">✦</span> UV O GRACH × THE GAME AWARDS</div>
      <h1><%= @event.title %></h1>
      <p>Wybierz propozycje, które mają trafić na planszę bingo The Game Awards.</p>
      <div class="hero-actions"><a href="#options" class="button primary">Zobacz propozycje <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <div class="voting-shell" data-controller="event-status" data-event-status-url-value="<%= state_event_path(@event, q: @query.presence) %>" data-event-status-phase-value="<%= @event.phase %>" data-event-status-revision-value="<%= @event.revision %>">
    <div data-event-status-target="schedule"><%= render "events/voting_schedule" %></div>
    <div class="voting-layout" id="options">
      <section class="options-section">
        <div class="voting-feedback" data-event-status-target="feedback" role="status" aria-live="polite" aria-atomic="true"><% %w[voting_notice voting_alert].each do |type| %><% if flash[type] %><div class="flash <%= type == 'voting_alert' ? 'alert' : 'notice' %>"><%= flash[type] %></div><% end %><% end %></div>
        <div class="section-title"><div><h2>Propozycje<span class="count-badge" data-event-status-target="optionCount"><%= @event.options.eligible.count %></span></h2></div></div>
        <% if @event.description.present? %><p class="section-description"><%= @event.description %></p><% end %>
        <%= form_with url: event_path(@event), method: :get, class: "search-form" do |form| %>
          <%= form.label :q, "Szukaj propozycji", class: "sr-only" %><span aria-hidden="true">⌕</span><%= form.search_field :q, value: @query, placeholder: "Szukaj propozycji…", maxlength: 100 %><%= form.submit "Szukaj", class: "search-button" %>
        <% end %>
        <div data-event-status-target="options"><%= render "events/voting_options" %></div>
      </section>
      <aside class="voting-sidebar" data-event-status-target="sidebar">
        <section class="panel ballot-panel" data-event-status-target="ballot">
          <%= render "events/ballot" %>
        </section>
        <section class="panel add-panel" data-event-status-target="addOption"><%= render "events/add_option" %>
        </section>
        <div class="how-it-works"><h2>Tworzenie planszy</h2><p>Na planszę trafi 25 propozycji z największą liczbą głosów. Pierwsza zajmie środek, a pozostałe pola zostaną rozmieszczone losowo. Remisy rozstrzyga losowanie.</p></div>
      </aside>
    </div>
  </div>
<% end %>
