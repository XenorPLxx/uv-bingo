<% content_for :title, "Losowanie · #{@event.title}" %>
<div class="reveal-page" data-controller="reveal">
  <%= render "shared/brand" %><span class="eyebrow">25 TYPÓW. JEDNA WSPÓLNA PLANSZA.</span><h1>Tak zagramy<br><span>tego wieczoru.</span></h1><p><%= @event.title %></p>
  <div class="reveal-controls"><button class="button primary" data-action="reveal#play" data-reveal-target="button">Odsłoń wylosowaną planszę ✦</button><%= link_to "Przejdź do planszy →", event_path(@event), class: "text-link" %></div>
  <p class="fineprint">Losowanie zapisano <%= @event.draw.created_at.in_time_zone.strftime('%d.%m.%Y o %H:%M:%S') %>. Odtwarzanie nie zmienia wyniku.</p>
  <div class="reveal-grid" data-reveal-target="grid"><%= render "events/board" %></div>
  <%= link_to "Pobierz zapis losowania ↓", draw_record_event_path(@event), class: "text-link" %>
</div>
