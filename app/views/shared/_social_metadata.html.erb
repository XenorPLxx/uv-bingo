<% image_description = "UV, Xenor i Foxtrot na kosmicznym tle z napisem UV o grach" %>
<%= tag.meta name: "description", content: metadata[:description] %>
<%= tag.link rel: "canonical", href: metadata[:url] %>
<%= tag.meta property: "og:type", content: "website" %>
<%= tag.meta property: "og:site_name", content: "TGA Bingo" %>
<%= tag.meta property: "og:locale", content: "pl_PL" %>
<%= tag.meta property: "og:title", content: metadata[:title] %>
<%= tag.meta property: "og:description", content: metadata[:description] %>
<%= tag.meta property: "og:url", content: metadata[:url] %>
<%= tag.meta property: "og:image", content: metadata[:image] %>
<%= tag.meta property: "og:image:type", content: "image/png" %>
<%= tag.meta property: "og:image:width", content: "1672" %>
<%= tag.meta property: "og:image:height", content: "941" %>
<%= tag.meta property: "og:image:alt", content: image_description %>
<%= tag.meta name: "twitter:card", content: "summary_large_image" %>
<%= tag.meta name: "twitter:title", content: metadata[:title] %>
<%= tag.meta name: "twitter:description", content: metadata[:description] %>
<%= tag.meta name: "twitter:image", content: metadata[:image] %>
<%= tag.meta name: "twitter:image:alt", content: image_description %>
