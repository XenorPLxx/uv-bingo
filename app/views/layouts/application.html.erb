<!DOCTYPE html>
<html lang="pl">
  <head>
    <title><%= content_for(:title) || "UV Bingo · The Game Awards" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#080b17">
    <meta name="description" content="Bingo społeczności UV o grach na The Game Awards. Głosowanie na propozycje i plansza aktualizowana na żywo.">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= 'presentation' if @presentation %>">
    <% unless @presentation %>
      <header class="site-header"><div class="header-inner"><%= render "shared/brand" %><nav aria-label="Nawigacja główna"><%= link_to "Wydarzenia", root_path, class: "nav-link" %><% if current_participant&.admin? %><%= link_to "Administracja", admin_root_path, class: "nav-link" %><% end %><% if current_participant %><span class="user-name"><%= current_participant.display_name %></span><%= button_to "Wyloguj", logout_path, method: :delete, class: "button small secondary" %><% else %><%= link_to "Zaloguj się", sign_in_path, class: "button small secondary" %><% end %></nav></div></header>
    <% end %>
    <main class="<%= @presentation ? 'presentation-main' : 'page-container' %>">
      <% flash.each do |type, message| %><div class="flash <%= type %>" role="<%= type == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <% unless @presentation %><footer class="site-footer"><%= render "shared/brand" %><p>Nieoficjalne bingo społeczności UV o grach na The Game Awards.</p><span class="footer-star" aria-hidden="true">✦</span></footer><% end %>
  </body>
</html>
