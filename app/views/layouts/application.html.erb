<!DOCTYPE html>
<html lang="pl" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "TGA Bingo · The Game Awards" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="theme-color" content="#080b17">
    <%= render "shared/social_metadata", metadata: social_preview_metadata %>
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= 'presentation' if @presentation %>">
    <% unless @presentation %>
      <header class="site-header">
        <div class="header-inner">
          <%= render "shared/brand" %>
          <div class="desktop-navigation"><%= render "shared/navigation" %></div>
          <details class="mobile-navigation" data-controller="mobile-menu" data-action="click@window->mobile-menu#dismissOutside keydown.esc@window->mobile-menu#dismissWithEscape">
            <summary data-mobile-menu-target="trigger">Menu <span class="menu-icon" aria-hidden="true"></span></summary>
            <%= render "shared/navigation" %>
          </details>
        </div>
      </header>
    <% end %>
    <main class="<%= @presentation ? 'presentation-main' : 'page-container' %>">
      <% flash.each do |type, message| %><% next if %w[voting_notice voting_alert].include?(type) %><div class="flash <%= type %>" role="<%= type == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <% unless @presentation %><footer class="site-footer"><%= render "shared/brand" %><p>Nieoficjalne bingo społeczności UV o grach na The Game Awards.</p><span class="footer-star" aria-hidden="true">✦</span></footer><% end %>
  </body>
</html>
