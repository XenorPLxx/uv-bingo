#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -f .envrc.local ]; then
  set -a
  source .envrc.local
  set +a
fi
bin/rails tailwindcss:build
bin/rails tailwindcss:watch &
watcher_pid=$!
trap 'kill "$watcher_pid" 2>/dev/null || true' EXIT INT TERM
bin/rails server -p "${PORT:-3100}"
