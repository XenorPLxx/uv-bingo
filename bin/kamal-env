#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
destination="${1:?Usage: bin/kamal-env staging|production COMMAND}"
shift
case "$destination" in staging|production) ;; *) echo 'Unknown destination' >&2; exit 1;; esac
set -a
source ".envrc.${destination}"
set +a
exec bundle exec kamal "$@" -d "$destination"
